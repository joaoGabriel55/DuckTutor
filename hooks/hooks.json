{
  "description": "Handle deterministic zero-model DuckTutor commands and restore learning state into new sessions.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/session-start.sh"
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "matcher": "^(ducktutor:)?config$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/config-command.sh"
          }
        ]
      },
      {
        "matcher": "^(ducktutor:)?clean$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/clean-command.sh"
          }
        ]
      }
    ]
  }
}
