{
  "description": "Handle deterministic zero-model DuckTutor commands.",
  "hooks": {
    "UserPromptExpansion": [
      {
        "matcher": "^(ducktutor:)?config$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/config-command.sh"
          }
        ]
      },
      {
        "matcher": "^(ducktutor:)?clean$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/clean-command.sh"
          }
        ]
      }
    ]
  }
}
